# Copy this file to `.env` and adjust for your machine:
#   cp .env.example .env
#
# Vite only exposes variables prefixed with VITE_ to client code, and it reads
# .env files at dev-server start — restart `npm run dev` after changing them.

# Base URL of the Resello backend, including the /api prefix.
# The backend defaults to port 3000 (see Backend/server.js).
VITE_API_BASE_URL=http://localhost:3000/api
